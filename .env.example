# Copy to .env (gitignored) and fill in.

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=memshin
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
POSTGRES_SSLMODE=disable

GOOSE_DRIVER=postgres
GOOSE_MIGRATION_DIR=./migrations

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional — defaults: gemini-2.5-flash, and the model's own sampling settings.
GEMINI_MODEL=
GEMINI_TEMPERATURE=
GEMINI_MAX_OUTPUT_TOKENS=

# Mid-term memory. The embedding model's output width is fixed at 768 by the
# schema's vector(768), so changing the model means a migration, not a setting.
# Optional — default: gemini-embedding-001.
GEMINI_EMBED_MODEL=

# Decomposes turns into retrieval probes and transcripts into facts. Runs on the
# request path ahead of the main generation, so it wants a small fast model.
# Optional — defaults: gemini-2.5-flash-lite, 4s.
GEMINI_ANALYST_MODEL=
GEMINI_ANALYST_TIMEOUT=


API_ADDR=:8082
